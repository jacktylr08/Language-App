# Production Environment Configuration
# Copy to .env.production and fill in actual values

# App
NODE_ENV=production
LOG_LEVEL=info

# Server
PORT=3001
API_URL=https://your-domain.com/api
FRONTEND_URL=https://your-domain.com

# Database (Managed PostgreSQL - Neon, Railway, PlanetScale, etc.)
DATABASE_URL=postgresql://user:password@host:5432/language_app
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=30

# Redis (Redis Cloud or managed service)
REDIS_URL=redis://default:password@host:6379
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# S3 (AWS S3 or Backblaze B2 or Wasabi)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=language-app-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_USE_PATH_STYLE=false

# Email (for notifications, password reset)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key

# Sentry (error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Features
ENABLE_SPEECH_TO_TEXT=false
ENABLE_CONVERSATION=false
ENABLE_REAL_MEDIA=false

# Frontend env vars
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1
