# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Server
PORT=3001
API_URL=http://localhost:3001
# Comma-separated list of allowed frontend origin(s). Unset = all origins
# allowed (fine for local dev, should be set in production).
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/language_app
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# S3 / Minio (for audio storage)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=language-app
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# Email (optional for MVP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Sentry (error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Features
ENABLE_SPEECH_TO_TEXT=false
ENABLE_CONVERSATION=false
ENABLE_REAL_MEDIA=false

# OpenAI — powers the tutor's brain, live voice calls, and text-to-speech.
# This is the only AI provider the app uses.
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=cedar
OPENAI_TTS_VOICE=coral
