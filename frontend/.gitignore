node_modules/
.next/
out/
# Anchored to the repo root on purpose. Unanchored, `build/` and `dist/` match
# a directory of that name at ANY depth — which silently swallowed the
# src/app/practice/build route, so a real source file was invisible to
# `git add -A` and would never have shipped. Next.js builds to .next/ and
# out/ (both above), so these two only ever meant the root anyway.
/build/
/dist/
*.log
.env
.env.local
.env.*.local
.DS_Store
.vscode/
.idea/
*.swp
*.swo
coverage/
pnpm-lock.yaml

# Build artifacts regenerated by `next build` — noise in every diff.
tsconfig.tsbuildinfo
public/worker-*.js

# Generated by scripts/build-sw.js on every build — noise in every diff, and
# it contains build-specific hashes that mean nothing in review.
public/sw.js
